# Instance
APP_URL=http://localhost:3000
# Production secret. Generate with openssl rand -base64 32.
AUTH_SECRET=
DATABASE_URL=
DATA_DIR=./data
ROLE=all
MIGRATE_ON_START=true
ALLOW_SIGNUP=false

# AI endpoints
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_STRUCTURED_OUTPUT=auto
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Media limits
MEDIA_ENABLED=
MEDIA_MAX_DURATION_MINUTES=180
YTDLP_COOKIES_FILE=
MAX_UPLOAD_MB=50
ALLOW_PRIVATE_NETWORK_FETCH=false
ALLOW_REMOTE_IMAGES=false
# Allow a trusted reverse proxy to set the client address via X-Real-IP.
TRUST_PROXY=false

# Library transfer limits
TRANSFER_MAX_UPLOAD_MB=256
TRANSFER_MAX_EXPANDED_MB=512
TRANSFER_MAX_ENTRY_MB=64
TRANSFER_MAX_ENTRIES=100000
TRANSFER_MAX_METADATA_MB=64

# Optional storage
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional account providers and password reset mail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=

# Logging
LOG_LEVEL=info

# Current adapters and integration API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
INTEGRATION_API_ENABLED=true
