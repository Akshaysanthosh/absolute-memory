{
  "name": "absolute-memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 0.0.0.0",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "absolute-memory": "node packages/cli/cli.mjs",
    "lint": "eslint .",
    "extension:zip": "node scripts/package-extension.mjs",
    "test:e2e": "playwright test",
    "dev:mock": "tsx tests/fixtures/mock-provider/main.ts",
    "setup": "npm ci --no-audit --no-fund && npm run db:migrate",
    "docker:build": "docker build -t absolute-memory:local .",
    "docker:lite": "sh docker/lite.sh",
    "docker:standard": "docker compose -f docker/compose.yml up --build -d",
    "check:hygiene": "tsx --test tests/integration/repo-hygiene.test.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:release": "sh scripts/check-release.sh",
    "docs:config": "tsx scripts/generate-configuration.ts",
    "docs:check": "tsx scripts/generate-configuration.ts --check",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "3.1164.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.13",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-bubble-menu": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/extension-unique-id": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "ai": "^7.0.179",
    "better-auth": "1.7.18",
    "csv-parse": "7.0.3",
    "dompurify": "^3.4.18",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.3",
    "linkedom": "0.18.15",
    "lucide-react": "^1.61.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "react-pdf": "11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "license": "UNLICENSED",
  "bin": {
    "absolute-memory": "packages/cli/cli.mjs"
  }
}
