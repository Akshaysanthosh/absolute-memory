{
  "manifest_version": 3,
  "name": "Absolute Memory \u2014 Save to your reading home",
  "version": "0.5.3",
  "description": "Save the current article to Absolute Memory with one click, then read and explore it in your library.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage", "alarms", "scripting", "sidePanel", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Absolute Memory capture",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save this article to Absolute Memory"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
